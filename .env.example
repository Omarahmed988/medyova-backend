# ─── Environment Template ────────────────────────────────
#
# Copy this file to the appropriate environment file:
#
#   Development:  cp .env.example .env.dev
#   Production:   cp .env.example .env.prod
#
# Then fill in the values. Never commit .env.dev or .env.prod.
#
# The DATABASE_URL must be copied EXACTLY from:
#   Supabase Dashboard → Settings → Database → Connection string → Session Pooler
#
# Do NOT construct or modify the URL manually.

# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────
# Paste the full Session Pooler URI from Supabase Dashboard here.
DATABASE_URL=
DB_POOL_MAX=10
