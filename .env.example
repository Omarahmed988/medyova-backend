# Medyova Backend Environment Configuration

# -----------------------------------------------------------------------------
# Database Connection
# -----------------------------------------------------------------------------
# Standard PostgreSQL connection string
DATABASE_URL=postgres://username:password@localhost:5432/medyova_db

# (Optional) Read Replica (Future-proofing)
# DB_READ_REPLICA_URL=postgres://username:password@localhost:5432/medyova_replica

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# JSON Web Token Secret (used for patient and pharmacy portals)
JWT_SECRET=super_secret_dev_key_change_in_production
JWT_EXPIRATION=7d

# -----------------------------------------------------------------------------
# System Workers Configuration
# -----------------------------------------------------------------------------
# Demand Signal Aggregator
DEMAND_AGGREGATOR_INTERVAL_MS=3600000

# Routing Heartbeat Stale Reclaimer
ROUTING_RECLAIMER_INTERVAL_MS=60000

# Subscription Cron Execution
SUBSCRIPTION_CRON_SCHEDULE="0 8 * * *"
